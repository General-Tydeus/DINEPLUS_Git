<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:local="clr-namespace:DINEPLUSBE"
             x:Class="DINEPLUSBE.FldrEntry.PageProductEditCategoryList" NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <StackLayout BackgroundColor="DodgerBlue">
            

            <SearchBar Placeholder="Search" TextChanged="SearchBar_TextChanged"/>
            <Frame BorderColor="White" Padding="1" Margin="5">
                <Grid  Padding="5" RowSpacing="0" BackgroundColor="DodgerBlue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="Description"  VerticalOptions="Center"  HorizontalTextAlignment="Center" TextColor="White"/>
                </Grid>
            </Frame>

                
                <ListView x:Name="LVCategoryList"  SeparatorVisibility="Default" SeparatorColor="Red" VerticalOptions="Center">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ContentView Padding="5">
                                <Frame Padding="5" BorderColor="White">
                                    <Grid Padding="0" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="lblCatCode" Grid.Column="0" Text="{Binding CatCode}" IsVisible="False" HorizontalTextAlignment="Start" VerticalOptions="Center"/>
                                        <Label x:Name="lblCatDesc" Grid.Column="0" Text="{Binding CatDesc}" IsVisible="True" HorizontalTextAlignment="Start" VerticalOptions="Center" TextColor="Red"/>
                                    </Grid>
                                    
                                    
                                </Frame>
                            </ContentView>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Padding="5" BackgroundColor="DodgerBlue" VerticalOptions="EndAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    
                </Grid.ColumnDefinitions>

                     <Button x:Name="btnRetMain" Text="Return to Main Menu" Clicked="btnRetMain_Clicked" VerticalOptions="EndAndExpand"
                           Grid.Row="0" Grid.Column="0" BackgroundColor="DodgerBlue" BorderColor="White" BorderWidth="1" TextColor="White"/>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>