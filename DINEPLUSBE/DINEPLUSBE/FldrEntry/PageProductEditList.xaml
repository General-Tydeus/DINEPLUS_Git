<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:local="clr-namespace:DINEPLUSBE"
             x:Class="DINEPLUSBE.FldrEntry.PageProductEditList" NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <StackLayout BackgroundColor="DodgerBlue">
            

            <SearchBar Placeholder="Search" TextChanged="SearchBar_TextChanged"/>
            <Frame BorderColor="White" Padding="1" Margin="5">
                <Grid  Padding="5" RowSpacing="0" BackgroundColor="DodgerBlue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="Description"  VerticalOptions="Center"  HorizontalTextAlignment="Center" TextColor="White"/>
                </Grid>
            </Frame>

                
                <ListView x:Name="LVProductList"  SeparatorVisibility="Default" SeparatorColor="Red" VerticalOptions="Center">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <ContentView Padding="5">
                                <Frame Padding="5" BorderColor="White">
                                    <Grid Padding="0" RowSpacing="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="lblProductCode" Grid.Column="0" Text="{Binding ProductCode}" IsVisible="False" HorizontalTextAlignment="Start" VerticalOptions="Center"/>
                                        <Label x:Name="lblProductDesc" Grid.Column="0" Text="{Binding ProductDesc}" IsVisible="True" HorizontalTextAlignment="Start" VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </ContentView>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                            x:Name="BtnInActiveAll"
                            BackgroundColor="DodgerBlue"
                            BorderColor="White"
                            BorderRadius="0"
                            BorderWidth="1"
                            Clicked="BtnInActiveAll_Clicked"
                            ContentLayout="Top, 10"
                            Text="In-Active All Products"
                            TextColor="White">
                <Button.Image>
                    <OnPlatform
                                    x:TypeArguments="FileImageSource"
                                    Android="setup.png"
                                    iOS="cube.ico" />
                </Button.Image>
            </Button>

        </StackLayout>
    </ContentPage.Content>
</ContentPage>