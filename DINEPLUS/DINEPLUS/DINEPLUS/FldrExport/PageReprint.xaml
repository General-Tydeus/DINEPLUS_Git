<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage  xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="RE - PRINT"
             BackgroundColor="Gray"
             NavigationPage.HasNavigationBar="False"
             xmlns:android="clr-namespace:Xamarin.Forms.PlatformConfiguration.AndroidSpecific;assembly=Xamarin.Forms.Core"
             android:TabbedPage.ToolbarPlacement="Bottom"
             android:TabbedPage.BarItemColor="White"
             android:TabbedPage.BarSelectedItemColor="Red"
             x:Class="DINEPLUS.FldrExport.PageReprint">

    <ContentPage Title="PAY AS YOU ORDER">
        <ContentPage.Content>
            <StackLayout BackgroundColor="White">
                <Label
                    Text="Pay as you Order"
                    FontSize="24"
                    TextColor="Black"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    />
                <BoxView Color="Black" HeightRequest="1" HorizontalOptions="FillAndExpand" Grid.Row="1" Grid.ColumnSpan="5"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Text="Date" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="Time" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Text="Doc #" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="3" Text="Amount" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>

                    <BoxView Color="Black" HeightRequest="1" Grid.Row="1" Grid.ColumnSpan="5"/>

                    <ListView x:Name="LV1" Grid.Row="2"  Grid.ColumnSpan="5" ItemTapped="LV1_ItemTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Frame Padding="0" BackgroundColor="White" >
                                        <Grid Padding="0" RowSpacing="0" ColumnSpacing="0" Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="2.5*" />
                                            </Grid.ColumnDefinitions>

                                            <Label Grid.Column="0" Text="{Binding TDate}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" TextColor="Black" FontSize="15"/>
                                            <Label Grid.Column="1" Text="{Binding OrderTime, StringFormat='{0:hh\\:mm tt}'}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" TextColor="Black" FontSize="15"/>
                                            <Label Grid.Column="2" Text="{Binding DocNum}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" TextColor="Black" FontSize="15"/>
                                            <Label Grid.Column="3" Text="{Binding CAmount, StringFormat='₱{0:0.00}'}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="Black" FontSize="15"/>

                                        </Grid>

                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>
            </StackLayout>

        </ContentPage.Content>
    </ContentPage>

    <ContentPage Title="PAY AFTER DINING">
        <ContentPage.Content>
            <StackLayout BackgroundColor="White">
                <Label
                    Text="Pay after Dining"
                    FontSize="24"
                    TextColor="Black"
                    VerticalOptions="CenterAndExpand"
                    HorizontalOptions="CenterAndExpand"
                    />
                <BoxView Color="Black" HeightRequest="1" HorizontalOptions="FillAndExpand" Grid.Row="1" Grid.ColumnSpan="5"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Text="Date" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="Time" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Text="Doc #" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="3" Text="Amount" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>

                    <BoxView Color="Black" HeightRequest="1" Grid.Row="1" Grid.ColumnSpan="5"/>

                    <ListView x:Name="LV2" Grid.Row="2"  Grid.ColumnSpan="5" ItemTapped="LV2_ItemTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Frame Padding="0" BackgroundColor="White" >
                                        <Grid Padding="0" RowSpacing="0" ColumnSpacing="0" Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="2.5*" />
                                            </Grid.ColumnDefinitions>

                                            <Label Grid.Column="0" Text="{Binding TDate}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" TextColor="Black" FontSize="15"/>
                                            <Label Grid.Column="1" Text="{Binding OrderTime, StringFormat='{0:hh\\:mm tt}'}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" TextColor="Black" FontSize="15"/>
                                            <Label Grid.Column="2" Text="{Binding DocNum}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" TextColor="Black" FontSize="15"/>
                                            <Label Grid.Column="3" Text="{Binding CAmount, StringFormat='₱{0:0.00}'}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="Black" FontSize="15"/>

                                        </Grid>

                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>
            </StackLayout>

        </ContentPage.Content>
    </ContentPage>
</TabbedPage>