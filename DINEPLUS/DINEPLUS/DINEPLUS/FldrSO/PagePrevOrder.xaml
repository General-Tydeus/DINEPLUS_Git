<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DINEPLUS.FldrSO.PagePrevOrder"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Content>
        <StackLayout>
            
            <Label
                FontSize="30"
                Text="PREVIOUS ORDERS"
                FontAttributes="Bold"
                TextColor="Black" 
                HorizontalOptions="Center"
                Margin="0"
                Padding="0"/>

            <Label
                FontAttributes="Bold"
                FontSize="15"
                Text="{Binding TableDesc}"
                TextColor="Red" 
                HorizontalOptions="Center"
                Margin="0"
                Padding="0"/>

            <Frame BackgroundColor="Red" BorderColor="DarkSlateGray" Padding="0">
                <Grid RowSpacing="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Text="Product"  VerticalOptions="Center"  HorizontalTextAlignment="Center" TextColor="White" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="Price"  VerticalOptions="Center"  HorizontalTextAlignment="Center" TextColor="White" FontAttributes="Bold"/>
                    <Label Grid.Column="2" Text="Qty"  VerticalOptions="Center"  HorizontalTextAlignment="Center" TextColor="White" FontAttributes="Bold"/>
                    <Label Grid.Column="3" Text="Total"  VerticalOptions="Center"  HorizontalTextAlignment="Center" TextColor="White" FontAttributes="Bold"/>

                    <BoxView BackgroundColor="DarkSlateGray" WidthRequest="1" Grid.Column="0" HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand"/>
                    <BoxView BackgroundColor="DarkSlateGray" WidthRequest="1" Grid.Column="1" HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand"/>
                    <BoxView BackgroundColor="DarkSlateGray" WidthRequest="1" Grid.Column="2" HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand"/>
                </Grid>
            </Frame>

            <ListView x:Name="LV1"  SeparatorVisibility="Default" SeparatorColor="Red" VerticalOptions="Center">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItem
                                        Text="Remove"
                                        BackgroundColor="Red"
                                        />
                                </SwipeView.RightItems>
                                <SwipeView.LeftItems>
                                    <SwipeItem
                                        Text="Remove"
                                        BackgroundColor="Red"
                                        />
                                </SwipeView.LeftItems>
                                <Frame Padding="0" BorderColor="DarkSlateGray">
                                    <Grid Padding="0" RowSpacing="0" >

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Text="{Binding ProductDesc}" IsVisible="True" Padding="20,0,0,0" HorizontalTextAlignment="Start" VerticalOptions="Center" TextColor="Black"/>
                                        <Label Grid.Column="1" Text="{Binding UP, StringFormat= '₱{0:#,0.#0}'}" IsVisible="True" HorizontalTextAlignment="End" VerticalOptions="Center" TextColor="Black" Padding="0,0,5,0"/>
                                        <Label Grid.Column="2" Text="{Binding POut}" IsVisible="True" HorizontalTextAlignment="Center" VerticalOptions="Center" TextColor="Black"/>
                                        <Label Grid.Column="3" Text="{Binding Totals, StringFormat= '₱{0:#,0.#0}'}" HorizontalTextAlignment="End" VerticalOptions="Center" TextColor="Red" FontAttributes="Bold" Padding="0,0,5,0"/>

                                        <BoxView BackgroundColor="DarkSlateGray"  WidthRequest="1" Grid.Column="0" HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand"/>
                                        <BoxView BackgroundColor="DarkSlateGray"  WidthRequest="1" Grid.Column="1" HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand"/>
                                        <BoxView  BackgroundColor="DarkSlateGray" WidthRequest="1" Grid.Column="2" HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand"/>

                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackLayout x:Name="SLName" BackgroundColor="white" HeightRequest="121">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="1"/>
                    </Grid.RowDefinitions>

                    <Button 
                    Text="Print BILL"
                    x:Name="btnPrint"
                    Grid.Column="0"
                    Grid.Row="1"
                    BackgroundColor="Navy"
                    CornerRadius="5"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    Margin="10,0,0,0"/>

                    <Button 
                    Text="PAY BILL"
                    x:Name="BtnPay"
                    Grid.Column="1"
                    Grid.Row="1"
                    BackgroundColor="Maroon"
                    CornerRadius="5"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    Margin="0,0,10,0"/>

                    <StackLayout 
                         Grid.Row="0"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Orientation="Horizontal"
                        HorizontalOptions="End">
                        <Label
                            IsVisible="True"
                            Text= "Total : "
                            TextColor="Green"
                            FontAttributes="Bold"/>
                        <Label
                            x:Name="lblTotals"
                            Grid.Column="3"
                            Text="₱ 0.00"
                            FontAttributes="Bold"
                            FontSize="30"
                            TextColor="Red"/>
                        
                    </StackLayout>

                </Grid>
            </StackLayout>




        </StackLayout>
    </ContentPage.Content>
</ContentPage>