<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage  xmlns="http://xamarin.com/schemas/2014/forms"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  x:Class="DINEPLUS.FldrSO.PopUpTakeOrd"
                  xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
                  xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                  CloseWhenBackgroundIsClicked="True"
                  >
    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="True"
            PositionIn="Center"
            PositionOut="Center"
            ScaleIn="1.2"
            ScaleOut="0.8" />

    </pages:PopupPage.Animation>
    <StackLayout
        Margin="5"
        Padding="5"
        BackgroundColor="White"
        HeightRequest="220"
        WidthRequest="350"
        HorizontalOptions="Center"
        VerticalOptions="StartAndExpand">
        <ScrollView>
            <StackLayout>
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="40" />

                        <RowDefinition Height="50" />

                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <!--<Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Reference :" />
                    <Entry
                        x:Name="txtRef"
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="Medium"
                        TextColor="Black"
                        Text="NA"/>-->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Remarks :" />
                    <Entry
                        x:Name="txtRemarks"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        FontSize="Medium"
                        TextColor="Black"
                        Text="App Sales"/>
                    <Label
                        FontSize="Subtitle"
                        FontAttributes="Bold"
                        Grid.Column="0"
                        Grid.Row="2"
                        Text="Total :" 
                        TextColor="Green"/>
                    <Label
                        x:Name="lblTotals"
                        FontAttributes="Bold"
                        Grid.Column="1"
                        Grid.Row="2"
                        FontSize="36"
                        Text="0.00" 
                        TextColor="DarkRed"
                        HorizontalTextAlignment="Center"/>

                    <Button
                    x:Name="BtnPost"
                    Clicked="BtnPost_Clicked"
                    Grid.Row="3"
                    Grid.Column="1"
                    BackgroundColor="Green"
                    CornerRadius="10"
                    FontSize="Default"
                    IsEnabled="True"
                    Text="Post"
                    TextColor="White" />


                    <Button
                    x:Name="btnClose"
                        Clicked="btnClose_Clicked"
                    Grid.Row="3"
                    Grid.Column="0"
                    BackgroundColor="Crimson"
                    CornerRadius="10"
                    FontSize="Default"
                    IsEnabled="True"
                    Text="Close"
                    TextColor="White" />


                </Grid>
            </StackLayout>
        </ScrollView>
    </StackLayout>
</pages:PopupPage>