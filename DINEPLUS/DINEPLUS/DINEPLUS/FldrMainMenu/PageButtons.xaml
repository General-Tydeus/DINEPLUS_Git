<?xml version="1.0" encoding="utf-8" ?>
<ContentView  xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DINEPLUS.FldrMainMenu.PageButtons">
    <ContentView.Content>
        <Grid BackgroundColor="LightBlue" ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button 
                ImageSource="cashsales.png"
                x:Name="btnPayo"
                BackgroundColor="#2A2929"
                TextColor="White"
                Text="Pay as you Order"
                Clicked="btnPayo_Clicked"
                FontFamily="CalibriBold"
                FontSize="16"
                CornerRadius="0"
                />

            <Button
                ImageSource="order.png"
                x:Name="btnSO"
                BackgroundColor="#2A2929"
                TextColor="White"
                Text="Pay after Dining"
                Grid.Column="1" 
                Clicked="btnSO_Clicked"
                CornerRadius="0"
                FontFamily="CalibriBold"
                FontSize="16"
                />
        </Grid>
    </ContentView.Content>
</ContentView>