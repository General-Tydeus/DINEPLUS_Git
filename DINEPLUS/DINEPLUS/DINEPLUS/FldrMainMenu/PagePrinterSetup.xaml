<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             x:Class="DINEPLUS.FldrMainMenu.PagePrinterSetup">
    <ContentPage.Content>
        <StackLayout BackgroundColor="DodgerBlue">
            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="CenterAndExpand"
                Text="BLUETOOTH PRINTER SETUP"
                TextColor="White"
                VerticalOptions="Start" />
            <StackLayout VerticalOptions="CenterAndExpand">
                <Label
                    x:Name="LblPrinterName"
                    FontSize="24"
                    HorizontalOptions="CenterAndExpand"
                    Text="Please select printer"
                    TextColor="Blue" />
                <Button
                    x:Name="btnSelectPrinter"
                    BackgroundColor="DodgerBlue"
                    BorderColor="White"
                    BorderWidth="1"
                    Clicked="btnSelectPrinter_Clicked"
                    Text="Select Bluetooth Printer"
                    TextColor="White" />
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>