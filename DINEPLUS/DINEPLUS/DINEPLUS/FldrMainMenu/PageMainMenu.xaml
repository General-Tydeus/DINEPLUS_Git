<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:local="clr-namespace:DINEPLUS.FldrMainMenu"
                    xmlns:pages="clr-namespace:DINEPLUS.FldrMainMenu"
                    x:Class="DINEPLUS.FldrMainMenu.PageMainMenu"
                    NavigationPage.HasNavigationBar="False"
                    xmlns:nav="clr-namespace:DINEPLUS.FldrMainMenu"
                    >
    <ContentPage.Content>
        <StackLayout BackgroundColor="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="1.5*" />
                    <RowDefinition Height="1.5*" />
                    <RowDefinition Height="1*" />
                   
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>


                <Button
                x:Name="btnPrinter" 
                Text="Bluetooth Printer"
                Clicked="btnPrinter_Clicked"
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                BackgroundColor="LightBlue" />

                <Button
                x:Name="btnLogout"
                Text="Log - Out"
                Clicked="btnLogout_Clicked"
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                BackgroundColor="LightBlue" />

                <nav:PageButtons 
                    Grid.Row="11" 
                    Grid.ColumnSpan="4"/>
    

            </Grid>


        </StackLayout>
        
    </ContentPage.Content>



</ContentPage>
