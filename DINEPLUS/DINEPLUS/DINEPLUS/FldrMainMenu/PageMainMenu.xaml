<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://xamarin.com/schemas/2014/forms"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:local="clr-namespace:DINEPLUS.FldrMainMenu"
                    xmlns:pages="clr-namespace:DINEPLUS.FldrMainMenu"
                    x:Class="DINEPLUS.FldrMainMenu.PageMainMenu"
                    NavigationPage.HasNavigationBar="False"
                    BarBackgroundColor="LightSkyBlue"
                    BarTextColor="White"
                    >
    <TabbedPage.Children>
        <ContentPage x:Name="homePage" Title="HOME">
            <StackLayout>
                <StackLayout 
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="StartAndExpand">

                    <Label
                        TextColor="Black"
                        VerticalOptions="CenterAndExpand"
                        HorizontalOptions="CenterAndExpand"
                        FontSize="40"
                        >
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Welcome to" />
                                <Span Text="  " />
                                <Span Text="DINEPLUS+" FontAttributes="Italic" FontSize="40"  />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Image
                    HorizontalOptions="Center"
                    Aspect="AspectFill"
                    WidthRequest="150"
                    HeightRequest="150"
                    Margin="0,50,0,0"
                    Source="logo.jpg"
                    />
                </StackLayout>
                <StackLayout 
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="StartAndExpand">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>



                    <Button
                       x:Name="btnHome"
                       Text="Home"
                       BackgroundColor="LightSkyBlue"
                       BorderColor="Black"
                       BorderWidth="1"
                       HeightRequest="70"
                       Margin="60,0,60,0"
                       />
                    <Button
                       x:Name="btnSummary"
                       Text="Sales Report"
                       BackgroundColor="LightSkyBlue"
                       BorderColor="Black"
                       BorderWidth="1"
                       HeightRequest="70"
                       Margin="60,0,60,0"
                       />
                    <Button 
                       x:Name="btnLogout"
                       Text="Log out"
                       BackgroundColor="LightSkyBlue"
                       BorderColor="Black"
                       BorderWidth="1"
                       HeightRequest="70"
                       Margin="60,0,60,0"
                       Clicked="btnLogout_Clicked"
                       />
                </StackLayout>
                
            </StackLayout>
        </ContentPage>

        <NavigationPage x:Name="payoPage" Title="PAYO">
            <x:Arguments>
                <pages:PagePAYO />
            </x:Arguments>
        </NavigationPage >
        <NavigationPage x:Name="soPage" Title="SO">
            <x:Arguments>
                <pages:PageSO />
            </x:Arguments>
        </NavigationPage>
    </TabbedPage.Children>

    <!--<NavigationPage Title="PAYO">
        <x:Arguments>
            <pages:PagePAYO />
        </x:Arguments>
    </NavigationPage>

    <NavigationPage Title="SO">
        <x:Arguments>
            <pages:PageSO />
        </x:Arguments>
    </NavigationPage>

    <TabbedPage.Children>
        <ContentPage Title="HOME">
            <StackLayout>
                <Label Text="Home" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </StackLayout>
        </ContentPage>
    </TabbedPage.Children>-->

</TabbedPage>
