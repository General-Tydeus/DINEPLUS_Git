<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Pay as you Order"
             NavigationPage.HasNavigationBar="False"
                    xmlns:nav="clr-namespace:DINEPLUS.FldrMainMenu"
             
             x:Class="DINEPLUS.FldrMainMenu.PagePAYO">

    <ContentPage.Content>
        <StackLayout BackgroundColor="White">
            <Grid BackgroundColor="LightBlue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <Label
                    FontAttributes="Bold"
                    FontSize="30"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="Menu"
                    x:Name="focusme"
                    TextColor="Black"
                    VerticalOptions="CenterAndExpand"/>

                <ImageButton
                        x:Name="btnCart"
                        Source="cartwhite.png"
                        Grid.Row="0"
                        Grid.Column="3"
                        Aspect="AspectFit"
                        BackgroundColor="LightBlue"
                        HeightRequest="50"
                        WidthRequest="50"
                        Clicked="btnCart_Clicked"
                        VerticalOptions="Center" />
                <Label
                        x:Name="lblCartOrder"
                        Grid.Row="0"
                        Grid.Column="3"
                        FontAttributes="Bold"
                        FontSize="Large"
                        HorizontalTextAlignment="Center"
                        TextColor="Red"
                        Text="0"                        
                        VerticalOptions="Start" 
                        HorizontalOptions="End"/>
            </Grid>
            <CollectionView 
                x:Name="ClMenu" 
                x:FieldModifier="Public"
                SelectionMode="Single"
                ItemsLayout="VerticalGrid, 2"
                SelectionChanged ="ClMenu_SelectionChanged"
                BackgroundColor="White"
                >

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="3"
                            CornerRadius="20"
                            BorderColor="WhiteSmoke"
                         
                            >

                            <Grid Padding="10" Margin="15, 20, 15, 15" RowSpacing="0" ColumnSpacing="0" BackgroundColor="white">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!--<BoxView BackgroundColor="Black" HeightRequest="1" HorizontalOptions="FillAndExpand" Grid.Row="1" Grid.ColumnSpan="4" />-->

                                <Image
                                HeightRequest="60"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                Aspect="AspectFill"
                                WidthRequest="66"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                Source="rice.jpg"
                                />

                                <Label
                                    FontAttributes="Bold"
                                    TextColor="Red"
                                    VerticalOptions="End"
                                    HorizontalOptions="Center"
                                    Grid.Column="1"
                                    Grid.Row="0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ProductDesc}" TextColor="Black" FontSize="20" FontAttributes="Bold" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    FontAttributes="Bold"
                                    TextColor="Red"
                                    VerticalOptions="End"
                                    HorizontalOptions="Center"
                                    Margin="0,0,0,-20"
                                    Grid.Column="1"
                                    Grid.Row="0">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding SellingPrice, StringFormat='₱{0:0.00}'}" />
                                            <Span Text=" per " />
                                            <Span Text="{Binding UnitMeasure}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                            </Grid>
                        </Frame>
                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>
            <nav:PageButtons Grid.Row="1" />

        </StackLayout>
    </ContentPage.Content>
</ContentPage>